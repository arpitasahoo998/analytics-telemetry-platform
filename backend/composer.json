{
    "name": "analytics/backend",
    "description": "High-performance analytics event ingestion and query API",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Analytics\\": "src/",
            "Analytics\\Sdk\\": "../sdk/php/src/"
        }
    },
    "scripts": {
        "migrate": "php database/migrations.php",
        "serve": "php -S 127.0.0.1:8000 run-server.php",
        "test": "php tests/run-tests.php"
    }
}
